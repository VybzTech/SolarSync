# ---------------------------------------------------------------------
# SolarSync environment
# Copy to .env.local for development. In production these are set in the
# Netlify dashboard under Site configuration > Environment variables.
#
# Only VITE_-prefixed variables are exposed to the browser bundle. Never
# put the Supabase service_role key here — it belongs solely in Supabase
# Edge Function secrets.
# ---------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Tenant this deployment serves. Matches clients.slug in the database.
VITE_CLIENT_SLUG=folivision
